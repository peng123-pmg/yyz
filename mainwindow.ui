  <property name="styleSheet">
   <string notr="true">/* 所有QPushButton 磁贴基础样式 */
QPushButton {
    border: none;                  /* 移除原生按钮黑边框 */
    border-radius: 10px;           /* 圆角，可改成 0 直角磁贴 */
    background-color: #ffffff;
    color: #333333;
    font-size:14pt;
}

/* 鼠标悬浮在磁贴上面的效果 */
QPushButton:hover {
    background-color: #e8f0fe;     /* 悬浮浅蓝底色 */
}

/* 鼠标按下点击磁贴效果 */
QPushButton:pressed {
    background-color: #d0e1f7;
}


</string>
