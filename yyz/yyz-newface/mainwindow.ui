  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralWidget {
    background-color: #181a1d;
}
QLabel#videoLabel {
    background-color: #0f1114;
    border: 1px solid #2b2f35;
    border-radius: 8px;
    color: #6b7280;
    font-size: 14px;
}
QLabel#recogLabel {
    background-color: #22252a;
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 20px;
    font-weight: bold;
}
QLabel#stateDot {
    border-radius: 5px;
}
QLabel#statusLabel {
    color: #9aa0a8;
    font-size: 12px;
    background: transparent;
}
QFrame#controlFrame {
    background-color: #22252a;
    border: 1px solid #2b2f35;
    border-radius: 8px;
}
QComboBox#deviceCombo {
    background-color: #181a1d;
    border: 1px solid #33373d;
    border-radius: 6px;
    padding: 6px 10px;
    color: #e8eaed;
    min-width: 140px;
}
QComboBox#deviceCombo:hover {
    border-color: #3b82f6;
}
QComboBox#deviceCombo:focus {
    border-color: #3b82f6;
}
QComboBox#deviceCombo::drop-down {
    border: none;
    width: 26px;
}
QComboBox#deviceCombo QAbstractItemView {
    background-color: #22252a;
    color: #e8eaed;
    selection-background-color: #2f5d9a;
    border: 1px solid #33373d;
    outline: none;
}
QPushButton#startButton {
    background-color: #2ea56c;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#startButton:hover {
    background-color: #35b878;
}
QPushButton#startButton:pressed {
    background-color: #278e5d;
}
QPushButton#startButton:disabled {
    background-color: #1f3a2d;
    color: #6f8a7b;
}
QPushButton#stopButton {
    background-color: #e05252;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#stopButton:hover {
    background-color: #ea6363;
}
QPushButton#stopButton:pressed {
    background-color: #c84747;
}
QPushButton#stopButton:disabled {
    background-color: #3a2323;
    color: #a37b7b;
}
QPushButton#adminButton {
    background-color: #3b82f6;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#adminButton:hover {
    background-color: #4b8df5;
}
QPushButton#adminButton:pressed {
    background-color: #3270d6;
}</string>
